# ============ AI 分析引擎配置 ============

# provider 可选: openai / anthropic / mock
#   openai    - OpenAI 官方，或任何 OpenAI 兼容网关（Azure OpenAI / DeepSeek / 通义 / Kimi 等）
#   anthropic - Claude
#   mock      - 不调用真实模型，返回占位报告，用于本地开发调试
AI_PROVIDER=mock

# 模型名。留空则使用各 provider 的默认值（gpt-4o / claude-sonnet-4）
# 注意：必须是支持视觉（多模态）的模型
AI_MODEL=

# --- OpenAI / 兼容网关 ---
OPENAI_API_KEY=
# 自定义网关时填写，例如：
#   Azure:     https://<资源名>.openai.azure.com/openai/deployments/<部署名>
#   DeepSeek:  https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
ANTHROPIC_API_KEY=

# ============ 服务配置 ============
PORT=3001
